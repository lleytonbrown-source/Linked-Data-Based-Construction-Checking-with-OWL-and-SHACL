@prefix : <http://example.org/construction#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Alice a :Resource .

:Task1 a :Task ;
    :startDate "2025-01-01"^^xsd:date ;
    :endDate "2025-01-05"^^xsd:date ;
    :assignedTo :Alice .

:Task2 a :Task ;
    :startDate "2025-01-04"^^xsd:date ;
    :endDate "2025-01-10"^^xsd:date ;
    :dependsOn :Task1 ;
    :assignedTo :Alice .

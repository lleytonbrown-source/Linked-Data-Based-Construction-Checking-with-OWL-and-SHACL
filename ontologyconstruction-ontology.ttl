@prefix : <http://example.org/construction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Project rdf:type owl:Class .
:Task rdf:type owl:Class .
:Resource rdf:type owl:Class .

:hasTask rdf:type owl:ObjectProperty ;
    rdfs:domain :Project ;
    rdfs:range :Task .

:dependsOn rdf:type owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Task .

:assignedTo rdf:type owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Resource .

:startDate rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

:endDate rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .
